# WIC 2026 Trading Agent - Environment Configuration
# Copy to .env and fill in your values

# =========================================================================
# Application Mode
# =========================================================================
# dev: Development with your own LLM API
# trial: Competition trial period (Jan 4-31, 2027)
# live: Competition live period (Feb 1 - Mar 25, 2027)
MODE=dev

# =========================================================================
# LLM Provider Selection
# =========================================================================
# Options: openrouter, anthropic, openai, azure, gemini, ollama, nvidia, team_key, mock
LLM_PROVIDER=openrouter

# --- OpenRouter (Recommended for Development) ---
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.1

# --- Anthropic (Claude Direct) ---
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.1

# --- OpenAI (GPT Direct) ---
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# --- Azure OpenAI ---
# Get credentials from Azure portal
AZURE_API_KEY=your_azure_key_here
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT=your-deployment-name
AZURE_MAX_TOKENS=4096
AZURE_TEMPERATURE=0.1

# --- Google Gemini ---
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.1

# --- Ollama (Local) ---
# Install from: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:70b
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.1

# --- NVIDIA (Nemotron) ---
# Get key at: https://www.nvidia.com/en-us/research/
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.1

# --- Team Key (Competition - Provided by Organizers) ---
TEAM_KEY_API_URL=
TEAM_KEY_API_KEY=
TEAM_KEY_MODEL=
TEAM_KEY_SPENDING_CAP=100.0

# =========================================================================
# Interactive Brokers Connection
# =========================================================================
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1
IB_READONLY=false
IB_TIMEOUT=30

# IB Credentials (for IB Gateway container)
IB_USER=your_ib_username
IB_PASSWORD=your_ib_password
IB_TRADING_MODE=paper  # paper or live

# =========================================================================
# Market Data
# =========================================================================
MARKET_DATA_DELAY_MINUTES=15
DEFAULT_TIMEFRAME=15 mins
LOOKBACK_DAYS=30

# =========================================================================
# Strategy Configuration
# =========================================================================
STRATEGY_NAME=smc  # smc, mean_reversion, momentum, combined

# SMC Parameters
SMC_LOOKBACK_BARS=500
SMC_SWING_LENGTH=10
SMC_OB_LOOKBACK=50
SMC_FVG_MIN_SIZE=0.0001
SMC_LIQUIDITY_LOOKBACK=20

# Mean Reversion Parameters
MR_BB_PERIOD=20
MR_BB_STD=2.0
MR_RSI_PERIOD=14
MR_RSI_OVERBOUGHT=70.0
MR_RSI_OVERSOLD=30.0

# Momentum Parameters
MOM_MACD_FAST=12
MOM_MACD_SLOW=26
MOM_MACD_SIGNAL=9
MOM_ADX_PERIOD=14
MOM_ADX_THRESHOLD=25.0

# Review Scheduler
REVIEW_INTERVAL_MINUTES=60
REVIEW_ENABLED=true

# =========================================================================
# Risk Management
# =========================================================================
MAX_POSITION_SIZE=0.1
MAX_DRAWDOWN=0.05
MAX_SECTOR_EXPOSURE=0.3
MAX_CORRELATED_EXPOSURE=0.2
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
RISK_PER_TRADE=0.01
KELLY_FRACTION=0.25
MIN_LIQUIDITY_VOLUME=100000

# =========================================================================
# Dashboard
# =========================================================================
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_UPDATE_INTERVAL=5

# =========================================================================
# Compliance & Logging
# =========================================================================
LOG_LEVEL=INFO
LOG_ROTATION=1 day
LOG_RETENTION=30 days
OPERATION_LOG_ENABLED=true
CHANGE_TRACKING_ENABLED=true

# =========================================================================
# Trading Universe
# =========================================================================
DEFAULT_SYMBOLS=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,JPM,BAC,GS,MS,XOM,CVX,JNJ,PFE,UNH
MAX_SYMBOLS=20

# =========================================================================
# Execution
# =========================================================================
ORDER_TYPE=LMT
ORDER_TIF=DAY
SLIPPAGE_TOLERANCE=0.001

# =========================================================================
# Health & Monitoring
# =========================================================================
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
ALERT_WEBHOOK_URL=

# =========================================================================
# Grafana (optional)
# =========================================================================
GRAFANA_PASSWORD=admin